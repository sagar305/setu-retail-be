// Setu Retail — database schema. See docs/PLAN.md §3.
// Every tenant table carries accountId; every query is scoped by it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Plans & billing ────────────────────────────────────────────────────────

/// A sellable plan and its limits. Limits live here (not in code) so they can
/// be changed without a deploy. A null limit means unlimited.
/// Contact-sales deals get their own row (isPublic = false).
model Plan {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique
  name              String
  isPublic          Boolean  @default(true)
  /// Monthly price in paise (INR). Used to convert remaining days when a
  /// customer switches plan mid-term; null for custom plans.
  monthlyPriceInr   Int?
  maxBranches       Int?
  maxStaff          Int?
  maxProducts       Int?
  maxCustomers      Int?
  maxOrdersPerMonth Int?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionSource {
  TRIAL
  KEY
}

/// A period during which an account is on a plan. An account's timeline is
/// its subscriptions ordered by startsAt; one may be queued in the future
/// ("start after my current plan").
model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  accountId    String             @db.Uuid
  planId       String             @db.Uuid
  source       SubscriptionSource
  startsAt     DateTime           @db.Timestamptz(3)
  endsAt       DateTime           @db.Timestamptz(3)
  redemptionId String?            @db.Uuid
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)

  account    Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan       Plan               @relation(fields: [planId], references: [id])
  redemption LicenseRedemption? @relation(fields: [redemptionId], references: [id])

  @@index([accountId, startsAt])
  @@map("subscriptions")
}

enum RedemptionMode {
  EXTEND
  SWITCH_NOW
  START_LATER
}

/// Each license key can be redeemed once: keyId is unique.
model LicenseRedemption {
  id            String         @id @default(uuid()) @db.Uuid
  keyId         String         @unique
  accountId     String         @db.Uuid
  userId        String         @db.Uuid
  planCode      String
  days          Int
  mode          RedemptionMode
  /// Extra days added from converting the remaining current plan (SWITCH_NOW).
  convertedDays Int            @default(0)
  redeemedAt    DateTime       @default(now()) @db.Timestamptz(3)

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([accountId])
  @@map("license_redemptions")
}

/// One trial per email; a phone or tax number already used can't start
/// another. Kept even if the account is later removed.
model TrialClaim {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  phone     String   @unique
  taxNumber String?  @unique
  accountId String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("trial_claims")
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

model Account {
  id                      String    @id @default(uuid()) @db.Uuid
  name                    String
  /// Digits only, last 10 for Indian numbers (see lib/normalize.ts).
  phone                   String
  taxNumber               String?
  currency                String    @default("INR")
  timezone                String    @default("Asia/Kolkata")
  /// Next branch number; codes are B1, B2… and never reused.
  nextBranchNumber        Int       @default(1)
  /// Set when the plan shrank and the owner should review what stays active.
  keepActiveReviewPending Boolean   @default(false)
  /// Set by Setu (super-admin); blocks everyone.
  lockedBySetuAt          DateTime? @db.Timestamptz(3)

  // ── POS settings (owner) ──
  /// Charge GST on bills. On for accounts that signed up with a GSTIN.
  taxEnabled           Boolean  @default(false)
  /// Sell a stocked product even when its branch stock would go below zero.
  allowNegativeStock   Boolean  @default(true)
  /// Largest bill discount a cashier may give, in basis points (1000 = 10%).
  cashierMaxDiscountBp Int      @default(1000)
  receiptFooter        String   @default("Thank you for shopping with us!")
  /// "80mm" | "58mm" | "a4"
  receiptPaperSize     String   @default("80mm")
  /// Batch & expiry tracking (pharmacy/FMCG). Off by default.
  batchTracking        Boolean  @default(false)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  branches       Branch[]
  users          User[]
  subscriptions  Subscription[]
  redemptions    LicenseRedemption[]
  auditLogs      AuditLog[]
  categories     Category[]
  products       Product[]
  customers      Customer[]
  paymentMethods PaymentMethod[]
  orders         Order[]

  @@map("accounts")
}

model Branch {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @db.Uuid
  number     Int
  /// "B" + number; used in invoice numbers (B1-C2-00045).
  code       String
  name       String
  address    String    @default("")
  phone      String    @default("")
  gstin      String?
  /// Two-digit GST state code, e.g. "29" for Karnataka.
  stateCode  String?
  /// False when the plan allows fewer branches: kept, but read-only.
  withinPlan Boolean   @default(true)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  account  Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  users    UserBranch[]
  products BranchProduct[]
  counters Counter[]
  orders   Order[]

  @@unique([accountId, number])
  @@unique([accountId, code])
  @@index([accountId, createdAt])
  @@map("branches")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum UserStatus {
  /// Invited; has not set a password yet.
  INVITED
  ACTIVE
  /// Access removed by the owner or a manager.
  DISABLED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  accountId       String     @db.Uuid
  /// Stored lower-case; unique across Setu Retail so login needs no business id.
  email           String     @unique
  /// Stored lower-case; unique across Setu Retail.
  username        String     @unique
  name            String
  role            Role
  status          UserStatus @default(ACTIVE)
  passwordHash    String?
  emailVerifiedAt DateTime?  @db.Timestamptz(3)
  /// False when the plan allows fewer staff: cannot sign in until upgraded.
  withinPlan      Boolean    @default(true)
  failedLogins    Int        @default(0)
  lockedUntil     DateTime?  @db.Timestamptz(3)
  lastLoginAt     DateTime?  @db.Timestamptz(3)
  /// Counter PIN for offline sign-in: PBKDF2-SHA256 verifier (hex), its salt and rounds.
  /// Sent to this user's branch counters so they can check the PIN with no internet.
  pinHash         String?
  pinSalt         String?
  pinIterations   Int?
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  account  Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  branches UserBranch[]
  sessions Session[]
  tokens   OneTimeToken[]

  @@index([accountId, createdAt])
  @@map("users")
}

/// Manager → one or more branches; cashier → exactly one. Owner → none (all).
model UserBranch {
  userId   String @db.Uuid
  branchId String @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

// ─── Auth ───────────────────────────────────────────────────────────────────

/// A signed-in device. The refresh token rotates on every use; the session
/// itself ends 12 hours after sign-in regardless (one shift).
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  /// The hash before the last rotation; seeing it again means the token was
  /// stolen and replayed, so the session is revoked.
  previousHash     String?   @unique
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  userAgent        String    @default("")
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  INVITE
}

/// Emailed links. Only a SHA-256 of the token is stored.
model OneTimeToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime     @db.Timestamptz(3)
  usedAt    DateTime?    @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("one_time_tokens")
}

// ─── Platform ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  data       Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("audit_logs")
}

// ─── Catalogue & stock ──────────────────────────────────────────────────────
// Quantities are integer thousandths ("milli") so 1.5 kg = 1500; money is paise.

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @db.Uuid
  name       String
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([accountId])
  @@map("categories")
}

/// One catalogue for the business; price and stock are per branch (BranchProduct).
model Product {
  id            String    @id @default(uuid()) @db.Uuid
  accountId     String    @db.Uuid
  categoryId    String?   @db.Uuid
  name          String
  sku           String    @default("")
  barcode       String    @default("")
  hsn           String    @default("")
  /// GST rate in basis points: 500 = 5%, 1800 = 18%.
  gstRateBp     Int       @default(0)
  /// True when the price already includes GST (MRP-style).
  taxInclusive  Boolean   @default(true)
  unit          String    @default("pcs")
  /// Default selling price in paise; a branch may override it.
  price         Int
  /// Cost in paise; owner/manager only.
  costPrice     Int?
  trackStock    Boolean   @default(true)
  /// Stock at or below this (milli) counts as low; null = 5 units.
  lowStockMilli Int?
  archivedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  account  Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  branches BranchProduct[]

  @@index([accountId, name])
  @@index([accountId, barcode])
  @@map("products")
}

/// A product in a branch: its own price (or the default) and its stock.
model BranchProduct {
  branchId   String   @db.Uuid
  productId  String   @db.Uuid
  /// Paise; null = use the product's default price.
  price      Int?
  stockMilli Int      @default(0)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([branchId, productId])
  @@index([productId])
  @@map("branch_products")
}

enum InventoryChange {
  OPENING
  ADD
  REDUCE
  SET
  SALE
  CANCEL
  RETURN
}

model InventoryLog {
  id              String          @id @default(uuid()) @db.Uuid
  accountId       String          @db.Uuid
  branchId        String          @db.Uuid
  productId       String          @db.Uuid
  type            InventoryChange
  changeMilli     Int
  stockAfterMilli Int
  note            String          @default("")
  /// The order or credit note behind a SALE / CANCEL / RETURN.
  refId           String?         @db.Uuid
  userId          String?         @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)

  @@index([branchId, productId, createdAt])
  @@map("inventory_logs")
}

// ─── Sales ──────────────────────────────────────────────────────────────────

model Customer {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @db.Uuid
  name       String
  /// Digits only (lib/normalize).
  phone      String    @default("")
  email      String    @default("")
  address    String    @default("")
  gstin      String?
  /// GST state code for place of supply, e.g. "27".
  stateCode  String?
  notes      String    @default("")
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([accountId, name])
  @@index([accountId, phone])
  @@map("customers")
}

enum PaymentKind {
  CASH
  UPI
  CARD
  /// Udhaar: needs a customer; balance tracked by the Customer Ledger (Phase 4).
  CREDIT
  OTHER
}

model PaymentMethod {
  id        String      @id @default(uuid()) @db.Uuid
  accountId String      @db.Uuid
  name      String
  kind      PaymentKind
  active    Boolean     @default(true)
  sort      Int         @default(0)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("payment_methods")
}

/// A billing counter (one device/browser) in a branch. Each has its own bill
/// and credit-note series, so counters never clash — even offline (Phase 3).
model Counter {
  id                   String    @id @default(uuid()) @db.Uuid
  branchId             String    @db.Uuid
  number               Int
  /// "C" + number, used in B1-C2-00045.
  code                 String
  name                 String
  nextInvoiceNumber    Int       @default(1)
  nextCreditNoteNumber Int       @default(1)
  lastSeenAt           DateTime? @db.Timestamptz(3)
  /// SHA-256 of the device key that lets this counter sync offline bills.
  deviceKeyHash        String?
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([branchId, number])
  @@map("counters")
}

enum OrderStatus {
  COMPLETED
  CANCELLED
}

/// A bill. Amounts are paise and frozen at the time of sale.
model Order {
  id            String      @id @db.Uuid
  accountId     String      @db.Uuid
  branchId      String      @db.Uuid
  counterId     String      @db.Uuid
  cashierId     String      @db.Uuid
  invoiceNumber String
  status        OrderStatus @default(COMPLETED)
  customerId    String?     @db.Uuid
  customerName  String      @default("")
  customerPhone String      @default("")
  customerGstin String?
  /// GST state code of the place of supply; null when GST is off.
  placeOfSupply String?
  interState    Boolean     @default(false)
  taxEnabled    Boolean
  discountType  String      @default("flat")
  /// Paise for "flat", basis points for "percent".
  discountValue Int         @default(0)
  subtotal      Int
  discountTotal Int
  taxableTotal  Int
  cgstTotal     Int
  sgstTotal     Int
  igstTotal     Int
  total         Int
  /// Sum of credit notes against this bill.
  returnedTotal Int         @default(0)
  note          String      @default("")
  cancelledAt   DateTime?   @db.Timestamptz(3)
  cancelledById String?     @db.Uuid
  cancelReason  String      @default("")
  /// Made on a counter without internet and synced later.
  offline       Boolean     @default(false)
  /// An offline bill whose prices differ from the branch price when it synced.
  priceDiffers  Boolean     @default(false)
  syncedAt      DateTime?   @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  account     Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  counter     Counter        @relation(fields: [counterId], references: [id])
  customer    Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payments    OrderPayment[]
  creditNotes CreditNote[]

  @@unique([accountId, invoiceNumber])
  @@index([accountId, createdAt])
  @@index([branchId, createdAt])
  @@index([cashierId, createdAt])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @db.Uuid
  productId        String? @db.Uuid
  position         Int
  name             String
  hsn              String
  unit             String
  qtyMilli         Int
  unitPrice        Int
  gstRateBp        Int
  taxInclusive     Boolean
  /// Price × qty before discount.
  gross            Int
  /// This line's share of the bill discount.
  discount         Int
  taxable          Int
  cgst             Int
  sgst             Int
  igst             Int
  /// What the customer pays for this line.
  total            Int
  /// Cost per unit at sale time (paise), for margin reports.
  unitCost         Int?
  returnedQtyMilli Int     @default(0)

  order   Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  batches OrderItemBatch[]

  @@index([orderId])
  @@map("order_items")
}

model OrderPayment {
  id         String      @id @default(uuid()) @db.Uuid
  orderId    String      @db.Uuid
  methodId   String?     @db.Uuid
  methodName String
  kind       PaymentKind
  amount     Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_payments")
}

/// A GST credit note for returned items (a partial or full return).
model CreditNote {
  id               String      @id @default(uuid()) @db.Uuid
  accountId        String      @db.Uuid
  orderId          String      @db.Uuid
  branchId         String      @db.Uuid
  counterId        String      @db.Uuid
  userId           String      @db.Uuid
  number           String
  reason           String      @default("")
  refundMethodId   String?     @db.Uuid
  refundMethodName String
  refundKind       PaymentKind
  taxableTotal     Int
  cgstTotal        Int
  sgstTotal        Int
  igstTotal        Int
  total            Int
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)

  order Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items CreditNoteItem[]

  @@unique([accountId, number])
  @@index([orderId])
  @@index([branchId, createdAt])
  @@map("credit_notes")
}

model CreditNoteItem {
  id           String @id @default(uuid()) @db.Uuid
  creditNoteId String @db.Uuid
  orderItemId  String @db.Uuid
  qtyMilli     Int
  taxable      Int
  cgst         Int
  sgst         Int
  igst         Int
  total        Int

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
  @@map("credit_note_items")
}

/// A parked bill to recall later at the same branch.
model HeldCart {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @db.Uuid
  branchId  String   @db.Uuid
  userId    String   @db.Uuid
  label     String
  /// { lines: [{ productId, qtyMilli }], customerId, discount }
  payload   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([branchId, createdAt])
  @@map("held_carts")
}

// ─── Batches & expiry (when Account.batchTracking is on) ────────────────────
// BranchProduct.stockMilli stays the one stock number; batches say WHICH units
// those are. Sales take the batch that expires first (FEFO) unless the cashier
// picks one.

model Batch {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @db.Uuid
  branchId   String    @db.Uuid
  productId  String    @db.Uuid
  /// Supplier's batch / lot number; "" when unknown.
  batchNo    String    @default("")
  /// Expiry day; null = no expiry.
  expiry     DateTime? @db.Date
  /// Cost per unit (paise) for this batch; null = the product's cost.
  costPrice  Int?
  qtyMilli   Int
  /// Catch-all batch for stock that came in without batch details.
  opening    Boolean   @default(false)
  note       String    @default("")
  receivedAt DateTime  @default(now()) @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  allocations OrderItemBatch[]

  @@index([branchId, productId, expiry])
  @@index([accountId, expiry])
  @@map("batches")
}

/// Which batches the units of a bill line came from, and what they cost.
model OrderItemBatch {
  id            String @id @default(uuid()) @db.Uuid
  orderItemId   String @db.Uuid
  batchId       String @db.Uuid
  qtyMilli      Int
  /// Units of this allocation already put back (cancel / return).
  restoredMilli Int    @default(0)
  unitCost      Int?

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([batchId])
  @@map("order_item_batches")
}
