# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
# Any PostgreSQL connection string. On Vercel use the provider's pooled URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/setu_retail
# Browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Database connections per API instance (Vercel runs many instances).
DATABASE_POOL_MAX=5

# The web app's address (used in emailed links).
APP_URL=http://localhost:5173
# Required in production: long random strings. Generate with: openssl rand -base64 48
JWT_SECRET=
# Must match the value on setutechnology.com, which issues the keys.
RETAIL_LICENSE_SECRET=
# Resend (https://resend.com). Without a key, emails are printed to the console.
RESEND_API_KEY=
MAIL_FROM=Setu Retail <no-reply@setutechnology.com>
# Vercel Cron sends it to /internal/cron/reminders (daily plan-ending emails). 16+ random characters.
CRON_SECRET=

# Optional: a separate database for the integration tests (npm test).
TEST_DATABASE_URL=

# "/api" when the web app reaches this API through its own address (Vercel rewrite /api/* → API). Empty with a separate API domain.
COOKIE_PATH_PREFIX=
# Sign-in / sign-up rate limits. Only "off" for tests and load tests.
RATE_LIMITS=on

# Demo deployment ONLY (its own Vercel project and its own database).
# Every DEMO_RESET_INTERVAL_HOURS (from midnight UTC) the first request wipes the
# database and restores demo-dump/demo.json.gz, dated to now. See README → Demo.
# DEMO_RESET_ENABLED=1
# DEMO_RESET_INTERVAL_HOURS=2
# DEMO_RESET_EXPECT_DB=setu_retail_demo
# DEMO_RESET_DUMP_PATH=demo-dump/demo.json.gz
