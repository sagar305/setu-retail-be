# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
# Any PostgreSQL connection string. On Vercel use the provider's pooled URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/setu_retail
# Browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# The web app's address (used in emailed links).
APP_URL=http://localhost:5173
# Required in production: long random strings. Generate with: openssl rand -base64 48
JWT_SECRET=
# Must match the value on setutechnology.com, which issues the keys.
RETAIL_LICENSE_SECRET=
# Resend (https://resend.com). Without a key, emails are printed to the console.
RESEND_API_KEY=
MAIL_FROM=Setu Retail <no-reply@setutechnology.com>

# Optional: a separate database for the integration tests (npm test).
TEST_DATABASE_URL=
