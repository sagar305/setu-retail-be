# Railway Production Environment Variables
# Set these in your Railway dashboard

PORT=5000
NODE_ENV=production

# MongoDB Connection (use MongoDB Atlas or Railway's MongoDB plugin)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/setu-retail-pos

# JWT Configuration (change these to secure random values)
JWT_SECRET=your-production-jwt-secret-key-change-this
JWT_EXPIRE=7d

# AWS S3 Configuration (optional, for file uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Email Configuration (for notifications)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password

# Frontend URL
FRONTEND_URL=https://your-vercel-frontend-url.vercel.app
